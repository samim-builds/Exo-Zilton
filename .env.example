# Exo Zilton — environment variables
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# Setup guide for every variable: docs/ENVIRONMENT.md
# Never commit `.env` — only this example file is tracked.

# ─── Database (required for orders and the admin panel) ──────────────────────
# Neon Postgres pooled connection string (host contains "-pooler").
DATABASE_URL=postgresql://url/neondb?sslmode=sslmode=verify-full&channel_binding=require"

# ─── Admin login (required) ──────────────────────────────────────────────────
# Random string, at least 32 characters. Encrypts the admin session cookie.
SESSION_SECRET="SECRET_TEST"
# Set ONE of these. A bcrypt hash is recommended; the plain password is only
# used when no hash is set.
ADMIN_PASSWORD_HASH="HASH_PASS."
ADMIN_PASSWORD="PASS"

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://exozilton.com"
# Country code + number, digits only (no +, spaces or dashes).
NEXT_PUBLIC_WHATSAPP_NUMBER="923009643586"
# Inbox that receives new-order alerts and contact-form inquiries.
CONTACT_EMAIL="support@exozilton.com"

# ─── Email via Resend (optional — without it emails are only logged) ─────────
RESEND_API_KEY="API_KEY"
RESEND_FROM="Exo Zilton <support@exozilton.com>"

# ─── Image uploads via Vercel Blob (optional locally, required on Vercel) ───
# Without it, admin uploads are saved to public/uploads (local dev only).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx"

# ─── Instagram feed (optional) ───────────────────────────────────────────────
NEXT_PUBLIC_INSTAGRAM_HANDLE="exozilton_"
# Elfsight Instagram widget ID; leave empty to show the built-in fallback grid.
NEXT_PUBLIC_ELFSIGHT_INSTAGRAM_WIDGET_ID=""
