generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductKind {
  STANDARD
  BUNDLE
}

enum AttributeType {
  TEXT
  NUMBER
  SELECT
  BOOLEAN
}

enum AttributeScope {
  PRODUCT
  VARIANT
}

model Category {
  id             String              @id @default(cuid())
  slug           String              @unique
  name           String
  description    String?
  imageUrl       String?
  parentId       String?
  parent         Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]          @relation("CategoryTree")
  sortOrder      Int                 @default(0)
  published      Boolean             @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  attributes     CategoryAttribute[]
  products       Product[]
}

// Spec fields for a product type (e.g. diameter for mortars). Child
// categories inherit their ancestors' attributes.
model CategoryAttribute {
  id         String         @id @default(cuid())
  categoryId String
  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key        String
  label      String
  type       AttributeType  @default(TEXT)
  unit       String?
  options    String[]
  scope      AttributeScope @default(PRODUCT)
  required   Boolean        @default(false)
  sortOrder  Int            @default(0)

  @@unique([categoryId, key])
}

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  subtitle         String?
  kind             ProductKind      @default(STANDARD)
  status           ProductStatus    @default(ACTIVE)
  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description      String
  features         String[]
  careInstructions String[]
  deliveryInfo     String
  specs            Json
  attributes       Json             @default("{}")
  tags             String[]
  featured         Boolean          @default(false)
  sortOrder        Int              @default(0)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  images           ProductImage[]
  options          ProductOption[]
  variants         ProductVariant[]
  orderItems       OrderItem[]

  // Legacy per-size columns, kept nullable while the previous deployment still
  // reads them. Dropped in a later contract migration.
  sku        String? @unique
  size       String?
  diameterCm Float?
  capacityMl Int?
  pricePKR   Int?
  priceUSD   Int?
  inStock    Boolean @default(true)
  published  Boolean @default(true)
}

model ProductOption {
  id        String               @id @default(cuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  position  Int                  @default(0)
  values    ProductOptionValue[]

  @@unique([productId, name])
}

model ProductOptionValue {
  id       String               @id @default(cuid())
  optionId String
  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value    String
  slug     String
  position Int                  @default(0)
  variants VariantOptionValue[]

  @@unique([optionId, slug])
}

model ProductVariant {
  id                String               @id @default(cuid())
  productId         String
  product           Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String               @unique
  title             String
  pricePKR          Int
  priceUSD          Int
  compareAtPKR      Int?
  compareAtUSD      Int?
  costPKR           Int?
  trackInventory    Boolean              @default(false)
  stockQty          Int                  @default(0)
  lowStockThreshold Int                  @default(5)
  weightGrams       Int?
  attributes        Json                 @default("{}")
  legacySlug        String?              @unique
  position          Int                  @default(0)
  active            Boolean              @default(true)
  isDefault         Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  optionValues      VariantOptionValue[]
  images            ProductImage[]
  orderItems        OrderItem[]

  @@index([productId, position])
}

model VariantOptionValue {
  variantId     String
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValueId String
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  PAY_ON_CONFIRMATION
}

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Order {
  id                  String               @id @default(cuid())
  number              Int                  @unique @default(autoincrement())
  customerId          String
  customer            Customer             @relation(fields: [customerId], references: [id])
  status              OrderStatus          @default(PENDING)
  paymentMethod       PaymentMethod
  paid                Boolean              @default(false)
  currency            String
  subtotal            Int
  shipping            Int                  @default(0)
  total               Int
  name                String
  email               String
  phone               String
  addressLine         String
  city                String
  postalCode          String?
  country             String
  notes               String?
  courier             String?
  trackingNumber      String?
  // Last 10 digits of phone, for the first-order and per-customer checks.
  phoneNormalized     String?
  discountCode        String?
  discountAmount      Int                  @default(0)
  voucherCode         String?
  voucherAmount       Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  items               OrderItem[]
  discountRedemptions DiscountRedemption[]
  voucherTransactions VoucherTransaction[]

  @@index([status, createdAt])
  @@index([email])
  @@index([phoneNormalized])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  sku         String
  size        String
  unitPrice   Int
  quantity    Int
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  url       String
  alt       String
  sortOrder Int             @default(0)
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  STATUS
}

// Audit trail of admin changes. There is one shared admin login, so entries
// record the request origin rather than a user.
model ActivityLog {
  id         String         @id @default(cuid())
  entityType String
  entityId   String
  action     ActivityAction
  summary    String
  diff       Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime       @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String   @unique
  pathname  String
  alt       String   @default("")
  mime      String
  size      Int
  width     Int?
  height    Int?
  folder    String   @default("general")
  createdAt DateTime @default(now())

  @@index([folder, createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

enum DiscountType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum DiscountScope {
  ALL
  CATEGORIES
  PRODUCTS
}

enum DiscountKind {
  STANDARD
  WELCOME
}

model Discount {
  id               String               @id @default(cuid())
  code             String               @unique
  title            String
  type             DiscountType
  percentOff       Int?
  valuePKR         Int?
  valueUSD         Int?
  minSubtotalPKR   Int?
  minSubtotalUSD   Int?
  maxDiscountPKR   Int?
  maxDiscountUSD   Int?
  appliesTo        DiscountScope        @default(ALL)
  categoryIds      String[]
  productIds       String[]
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  // Redemptions so far; incremented atomically when an order uses the code.
  usedCount        Int                  @default(0)
  perCustomerLimit Int?
  firstOrderOnly   Boolean              @default(false)
  // Whether a gift voucher can be used on the same order.
  combinable       Boolean              @default(true)
  active           Boolean              @default(true)
  kind             DiscountKind         @default(STANDARD)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  redemptions      DiscountRedemption[]

  @@index([kind, active])
}

model DiscountRedemption {
  id            String   @id @default(cuid())
  discountId    String
  discount      Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerEmail String
  customerPhone String
  amount        Int
  currency      String
  createdAt     DateTime @default(now())

  @@unique([discountId, orderId])
  @@index([discountId, customerEmail])
  @@index([discountId, customerPhone])
}

enum VoucherReason {
  PURCHASE
  GIFT
  REFUND
  PROMO
}

enum VoucherTransactionReason {
  ISSUE
  REDEEM
  REFUND
  ADJUST
}

model GiftVoucher {
  id             String               @id @default(cuid())
  code           String               @unique
  currency       String
  initialBalance Int
  balance        Int
  expiresAt      DateTime?
  recipientEmail String?
  note           String?
  issuedReason   VoucherReason        @default(GIFT)
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  transactions   VoucherTransaction[]
}

model VoucherTransaction {
  id        String                   @id @default(cuid())
  voucherId String
  voucher   GiftVoucher              @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  delta     Int
  reason    VoucherTransactionReason
  note      String?
  createdAt DateTime                 @default(now())

  @@index([voucherId, createdAt])
}
